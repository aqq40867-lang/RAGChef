{
  "manifest_version": 3,
  "name": "RAGChef",
  "version": "1.0",
  "description": "An AI-powered recipe assistant using RAG and vector retrieval.",
  "action": {
    "default_popup": "popup.html"
  },
  "host_permissions": [
    "https://recipe-rag-extension.onrender.com/*",
    "http://localhost:8000/*",
    "http://127.0.0.1:8000/*"
  ]
}