{
  "name": "ragchef-extension",
  "version": "1.0.0",
  "private": true,
  "description": "Chrome extension (MV3) popup for RAGChef, written in TypeScript.",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "esbuild src/popup.ts --bundle --format=iife --target=es2022 --sourcemap --outfile=dist/popup.js",
    "watch": "npm run build -- --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.4",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
